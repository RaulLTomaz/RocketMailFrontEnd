{
  "expo": {
    "name": "RocketMailApp",
    "slug": "RocketMailApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./src/images/FAVICON.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O RocketMail precisa acessar suas fotos para a foto de perfil."
        }
      ]
    ]
  }
}
